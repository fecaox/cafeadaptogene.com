{
  "name": "cafeadaptogene/public-mcp",
  "description": "Serveur MCP public en lecture seule de cafeadaptogene.com",
  "type": "project",
  "require": {
    "php": "^8.1",
    "ext-fileinfo": "*",
    "laminas/laminas-httphandlerrunner": "^2.12",
    "mcp/sdk": "0.9.0",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "CafeAdaptogene\\Mcp\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false,
      "phpdocumentor/shim": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
