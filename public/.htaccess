RewriteEngine On

# Une seule version publique du site : HTTPS, sans www.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.cafeadaptogene\.com$ [NC]
RewriteRule ^ https://cafeadaptogene.com%{REQUEST_URI} [R=301,L]

# Point d’entrée public MCP, servi par PHP sans redirection vers /mcp/.
RewriteRule ^mcp/?$ mcp/index.php [L]

# Fusion SEO : une seule page de référence pour les cafés aux champignons.
RewriteRule ^cafe-champignon/?$ https://cafeadaptogene.com/cafe-champignons-plantes/ [R=301,L]
